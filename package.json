    "idb": "^8.0.4",
    "iron-session": "^9.1.0",
    "isomorphic-dompurify": "^4.7.0",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "next": "16.4.6",
    "node-html-parser": "^9.0.7",
    "node-ical": "^0.27.6",
    "openid-client": "^6.8.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
