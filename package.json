    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": true,
    "unrs-resolver": false
  }
