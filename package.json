{
  "name": "nomly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "node server.mts",
    "build": "next build && node scripts/generate-precache.mts",
    "start": "NODE_ENV=production node server.mts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/render-icons.mts",
    "seed": "node scripts/seed.ts",
    "migrate": "node scripts/migrate.mts",
    "dev:reset": "node scripts/dev-reset.mts",
    "seed:dev:create": "node scripts/dev-seed-create.mts",
    "seed:dev:load": "node scripts/dev-seed-load.mts",
    "token:create": "node scripts/create-api-token.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
